# --- Claude (server-only; NEVER prefix with NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=

# --- Upstash Redis (rate limiting) — provision via Vercel Marketplace ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend (Speed-to-Lead email demo) ---
RESEND_API_KEY=
LEAD_FROM_EMAIL="Portfolio <hi@yourdomain.com>"

# --- fal.ai (Optimistic OS real image generation) ---
FAL_KEY=

# --- Optional: salt for visitor hashing ---
VISITOR_SALT=

# --- Evals ---
# Bearer token for POST /api/evals/run (route is disabled when unset or under 16 chars)
EVAL_ADMIN_TOKEN=
# eval:gate default minimum pass rate (0-1)
EVAL_GATE_THRESHOLD=0.8
